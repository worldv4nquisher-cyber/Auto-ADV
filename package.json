{
  "name": "auto-adv",
  "private": true,
  "version": "0.0.1",
  "description": "全自动 AI 视觉小说生成器与播放器",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @auto-adv/desktop dev",
    "build": "pnpm --filter @auto-adv/desktop build",
    "dist:win": "pnpm --filter @auto-adv/desktop dist:win",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
